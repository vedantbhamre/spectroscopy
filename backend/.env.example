# Copy to backend/.env and fill in. Names follow the 8hr-MARATHON template.

# --- LLM: OpenAI ---
OPENAI_API_KEY=
OPENAI_FALLBACK_API_KEY=       # optional second key, tried when the primary fails (quota, rate limit)
OPENAI_MODEL=gpt-4o            # assessment model
OPENAI_FALLBACK_MODEL=gpt-4o-mini  # fallback, and first choice for the fast classifiers (safety gate, planner)
OPENAI_BASE_URL=               # optional: OpenAI-compatible endpoint
# Optional Portkey gateway (retry, cache, fallback). Create one integration per OpenAI key:
PORTKEY_API_KEY=
PORTKEY_SLUG=openai            # integration with OPENAI_API_KEY
PORTKEY_SLUG_2=openai-fallback # integration with OPENAI_FALLBACK_API_KEY

# --- Embeddings (Gemini, 3072-dim). Without a key, retrieval is lexical (BM25) only. ---
GEMINI_API_KEY=

# --- Qdrant. Empty endpoint = embedded local Qdrant in backend/.qdrant ---
QDRANT_CLUSTER_ENDPOINT=
QDRANT_API_KEY=
QDRANT_COLLECTION=afs_spectroscopy

# --- Observability (optional) ---
LOGFIRE_TOKEN=
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=spectrasense

# --- Safety gate: llm (default when an LLM key is set) | rules ---
GUARD_MODE=

# --- Evals: separate OpenAI key for the judge LLM ---
JUDGE_OPENAI_API_KEY=

# --- Frontend origin allowed by CORS ---
FRONTEND_ORIGIN=http://localhost:3000
