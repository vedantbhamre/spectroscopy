# Copy to backend/.env and fill in. Names follow the 8hr-MARATHON template.

# --- LLM provider: groq | openai. Each: primary + fallback key, large + small model. ---
LLM_PROVIDER=groq
LLM_FALLBACK_PROVIDER=         # optional: the other provider, tried after every attempt fails (empty = never)

# Groq (console.groq.com). Reasoning models get reasoning_effort=low automatically.
GROQ_API_KEY=
GROQ_FALLBACK_API_KEY=         # optional second key, tried when the primary fails (rate limit)
GROQ_MODEL=openai/gpt-oss-120b # assessment model
GROQ_SMALL_MODEL=openai/gpt-oss-20b  # fallback, and first choice for the safety gate and planner

# OpenAI
OPENAI_API_KEY=
OPENAI_FALLBACK_API_KEY=       # optional second key
OPENAI_MODEL=gpt-4o
OPENAI_FALLBACK_MODEL=gpt-4o-mini
OPENAI_BASE_URL=               # optional: OpenAI-compatible endpoint

# Optional Portkey gateway (retry, cache, fallback). One integration per key of the active provider:
PORTKEY_API_KEY=
PORTKEY_SLUG=openai            # integration with the primary key
PORTKEY_SLUG_2=openai-fallback # integration with the fallback key

# Retrieved chunks sent to the responder (main driver of input tokens per assessment)
RETRIEVE_TOP_N=8               # distinct pages sent to the composer
RERANK=off                     # flashrank: reorder keyword hits (measured no gain; off)

# --- Embeddings (Gemini, 3072-dim). Without a key, retrieval is lexical (BM25) only. ---
GEMINI_API_KEY=

# --- Qdrant. Empty endpoint = embedded local Qdrant in backend/.qdrant ---
QDRANT_CLUSTER_ENDPOINT=
QDRANT_API_KEY=
QDRANT_COLLECTION=afs_spectroscopy

# --- Observability (optional) ---
LOGFIRE_TOKEN=
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=            # EU workspaces: https://eu.api.smith.langchain.com
LANGSMITH_PROJECT=spectrasense

# --- Safety gate: llm (default when an LLM key is set) | rules ---
GUARD_MODE=

# --- Evals: separate OpenAI key for the judge LLM ---
JUDGE_OPENAI_API_KEY=
JUDGE_MODEL=gpt-4o-mini        # judge model on OpenAI (used when LLM_PROVIDER=openai)
JUDGE_GROQ=                    # judge key on Groq (used first when LLM_PROVIDER=groq)
JUDGE_GROQ_MODEL=openai/gpt-oss-120b
EVAL_COOLDOWN_MIN=30           # Evals page button: minutes between runs

# --- Frontend origin allowed by CORS ---
FRONTEND_ORIGIN=http://localhost:3000
