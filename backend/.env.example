# Copy to backend/.env and fill in. Names follow the 8hr-MARATHON template.

# --- LLM: Groq via Portkey gateway (primary 70B, fallback 8B) ---
PORTKEY_API_KEY=
GROQ_SLUG=rag            # Portkey virtual key / integration slug for Llama 3.3 70B
GROQ_SLUG_2=brag         # Portkey slug for the Llama 3.1 8B fallback
# Without Portkey the backend calls Groq directly with the same fallback order:
GROQ_API_KEY=
GROQ_FALLBACK_API_KEY=

# --- Embeddings (Gemini, 3072-dim). Without a key, retrieval is lexical (BM25) only. ---
GEMINI_API_KEY=

# --- Qdrant. Empty endpoint = embedded local Qdrant in backend/.qdrant ---
QDRANT_CLUSTER_ENDPOINT=
QDRANT_API_KEY=
QDRANT_COLLECTION=afs_spectroscopy

# --- Observability (optional) ---
LOGFIRE_TOKEN=
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=spectrasense

# --- Safety gate: llm (default when an LLM key is set) | rules ---
GUARD_MODE=

# --- Evals: separate Groq key for the judge LLM ---
JUDGE_GROQ=

# --- Frontend origin allowed by CORS ---
FRONTEND_ORIGIN=http://localhost:3000
