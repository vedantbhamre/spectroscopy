# SpectraSense backend settings
#
#   1. Copy this file:   cp .env.example .env
#   2. Paste your keys into .env (never into this template). Get them from the sites named below.
#   3. Start the backend: .venv/bin/uvicorn app.main:app --reload --port 8000
#
# Only GROQ_API_KEY is required. Everything else is optional: leave it empty if you don't use it.
# Write values without quotes or spaces. Restart the backend after changing .env.


# ── Required: the language model ─────────────────────────────────────────
# https://console.groq.com/keys → Create API Key
GROQ_API_KEY=


# ── Optional: more Groq quota ────────────────────────────────────────────
# A key from a second Groq account, used automatically when the first reaches its daily limit
# (keys of one account share that limit).
GROQ_FALLBACK_API_KEY=

# A key for the evaluation judge (Evals page → Run evals), ideally from another Groq account,
# so answers are marked by an independent model. Empty: the assistant's own model marks them.
JUDGE_GROQ=


# ── Optional: tracing (see every LLM call and pipeline step) ─────────────
# Pydantic Logfire: https://logfire.pydantic.dev → project → Settings → Write tokens
LOGFIRE_TOKEN=

# LangSmith: https://smith.langchain.com → Settings → API Keys. Set LANGSMITH_TRACING=true to turn it on;
# LANGSMITH_ENDPOINT only for a non-default region (e.g. https://eu.api.smith.langchain.com).
LANGSMITH_TRACING=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
LANGSMITH_ENDPOINT=


# Gemini embeddings ──────────────────────────────────────────
# Not used by default (search uses local BGE embeddings, no key). Only read when EMBEDDINGS=gemini
# and a Qdrant index has been built with app.ingestion.processor.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
